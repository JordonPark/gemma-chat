{
  "name": "my-buddy-support",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "d1_databases": [
    { "binding": "DB", "database_name": "my-buddy-support", "database_id": "REPLACE_WITH_D1_DATABASE_ID" }
  ],
  "ratelimits": [
    { "name": "SUBMISSIONS", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } }
  ],
  "triggers": { "crons": ["15 2 * * *"] }
}
