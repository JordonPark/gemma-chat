{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "channel": "production"
    },
    "store": {
      "distribution": "store",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_STORE_BUILD": "1"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true
    }
  }
}
